# Development-only settings. The packaged Mac app stores the DeepSeek key in the
# macOS keychain from its own settings screen; never put a real key in this file.

# ===== LLM =====
# DeepSeek OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ===== Knowledge base =====
# Folder of Markdown product docs, relative to backend/ (the demo ships a fictional product in data/knowledge)
KB_DIR=../data/knowledge

# ===== Retrieval =====
# Embedding model (Hugging Face id or local path)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# >= HIT threshold: return the matching doc answer directly (no LLM call)
# >= PARTIAL and < HIT: LLM answers using the top doc sections as context
# < PARTIAL: LLM is told nothing matched and says so instead of guessing
SIMILARITY_HIT_THRESHOLD=0.80
SIMILARITY_PARTIAL_THRESHOLD=0.60

FAISS_INDEX_PATH=./data/faiss_index
FAISS_TOP_K=3

# ===== Server (loopback only) =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:5173

# ===== Speech recognition =====
# Local faster-whisper model: tiny/base/small/medium/large-v3 or a local folder
ASR_MODEL=small
ASR_LANGUAGE=en
# Optional cloud fallback for recognition only (never used for answers)
DASHSCOPE_API_KEY=

# ===== Streaming recognition =====
STREAMING_ASR_ENABLED=true
STREAMING_ENGINE=local
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
STREAM_BOOT_RETRIES=3
DASHSCOPE_OPEN_TIMEOUT=15
STREAM_RECONNECT_MAX=3
STREAM_RECONNECT_BUFFER_MS=10000
STREAM_LOCAL_CHUNK_MS=1200
STREAM_LOCAL_TAIL_MS=700
STREAM_LOCAL_COMMIT_STALL_MS=2500
# Silence after speech before the UI shows "question ready" (a hint only; never auto-sends)
STREAM_QUESTION_READY_MS=1500

# ===== Backend audio capture =====
# Off on Mac: audio comes from the system share picker in the app.
BACKEND_CAPTURE_ENABLED=false
BACKEND_CAPTURE_DEVICE=

# ===== Answer trigger =====
# Manual only: the transcript goes into the input box and nothing is sent until the agent clicks Send.
AUTO_ANSWER=false
PREWARM_ENABLED=false
