{
  "name": "live-call-assistant-desktop",
  "version": "1.0.0",
  "description": "Live Call Assistant: real-time call assistant desktop app (Electron shell + React frontend + FastAPI backend)",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build-frontend": "npm run build --prefix frontend",
    "dist:mac": "bash scripts/build-mac-app.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.local.live-call-assistant",
    "productName": "Live Call Assistant",
    "asar": true,
    "electronDist": ".cache/electron/electron-v44.2.0-darwin-arm64.zip",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "backend/dist/call-assistant-backend",
        "to": "backend"
      },
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "data/knowledge",
        "to": "data/knowledge"
      },
      {
        "from": "backend/data/faiss_index",
        "to": "data/faiss_index"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Live Call Assistant captures the system audio you choose to share, so it can transcribe the caller's questions on this Mac.",
        "NSScreenCaptureUsageDescription": "Live Call Assistant uses the system share picker to access audio. The video track is stopped immediately; only the system audio you approve is kept."
      }
    }
  }
}
